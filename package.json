{
  "name": "edge-clock",
  "version": "0.1.0",
  "private": true,
  "description": "Server-rendered HTMX/SSE clock powered by Rust WebAssembly",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.28.0"
  },
  "scripts": {
    "build:worker": "bash scripts/build-worker.sh",
    "build:wasm": "pnpm run build:worker",
    "test:rust": "cargo test --manifest-path rust/clock-wasm/Cargo.toml",
    "test": "just test-live",
    "dev": "wrangler dev --local --live-reload --show-interactive-dev-session=true"
  }
}
